    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@oxlint/plugins": "^1.89.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
